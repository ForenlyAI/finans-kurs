{
  "name": "Finans 101 — çalışma kitapları + görüntüleyici",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "forwardPorts": [8765],
  "portsAttributes": {"8765": {"label": "Finans 101 — çalışma kitapları + görüntüleyici", "onAutoForward": "openBrowser"}},
  "postCreateCommand": "pip install --user uv==0.8.17 && export PATH=$HOME/.local/bin:$PATH && ./kontrol.sh",
  "postStartCommand": "nohup bash -c 'export PATH=$HOME/.local/bin:$PATH; uv run --frozen python -m http.server 8765 --bind 127.0.0.1 --directory goruntuleyici/site' > /tmp/lab-sunucu.log 2>&1 &",
  "customizations": {
    "vscode": {"extensions": ["ms-python.python"], "settings": {"workbench.startupEditor": "readme"}},
    "codespaces": {"openFiles": ["README.md"]}
  },
  "hostRequirements": {"cpus": 2, "memory": "4gb"}
}
